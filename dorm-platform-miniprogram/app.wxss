page {
  min-height: 100%;
  background: #f2f5f4;
  color: #233536;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  box-sizing: border-box;
  margin: 0;
  font-size: 27rpx;
  line-height: 1.35;
  border-radius: 8rpx;
}

button::after { border: 0; }

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 136rpx;
  box-sizing: border-box;
}

.hero {
  padding: 30rpx;
  border-radius: 8rpx;
  color: #fff;
  background: #174b4b;
}

.hero-kicker { color: rgba(255,255,255,.76); font-size: 24rpx; }
.hero-title { display: block; margin-top: 10rpx; font-size: 40rpx; line-height: 1.3; font-weight: 650; }
.hero-copy { display: block; margin-top: 8rpx; color: rgba(255,255,255,.84); font-size: 25rpx; line-height: 1.5; }

.card, .form-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #e3e9e7;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.section-title { display: block; margin: 30rpx 0 14rpx; color: #233536; font-size: 31rpx; line-height: 1.35; font-weight: 650; }
.section-inline { color: #233536; font-size: 28rpx; font-weight: 650; }
.muted { color: #647373; font-size: 24rpx; line-height: 1.5; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-width: 0; }
.row + .row { margin-top: 18rpx; }
.grow { flex: 1; min-width: 0; }
.label { color: #647373; font-size: 24rpx; }
.value { display: block; min-width: 0; margin-top: 6rpx; color: #233536; font-size: 29rpx; overflow-wrap: anywhere; }

.primary, .secondary, .danger, .outline {
  min-height: 68rpx;
  padding: 0 22rpx;
  border: 1rpx solid transparent;
  font-weight: 550;
}
.primary { color: #fff !important; background: #176fc1 !important; }
.secondary { color: #176257 !important; background: #e8f1ee !important; }
.danger { color: #a43d3b !important; background: #faeceb !important; }
.outline { color: #315a56 !important; background: #fff !important; border-color: #cbd8d4 !important; }
.button-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.button-row button { flex: 0 1 auto; max-width: 100%; min-height: 64rpx; padding: 0 18rpx; white-space: normal; }

.status {
  display: inline-flex;
  align-items: center;
  flex: none;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 4rpx;
  color: #42615c;
  background: #e9f0ed;
  font-size: 22rpx;
  line-height: 1.3;
}
.status.warning { color: #825b22; background: #f8f0df; }
.status.done { color: #286347; background: #e5f1e8; }
.status.danger { color: #963c3b; background: #f8e9e8; }

.empty, .loading { padding: 56rpx 24rpx; color: #647373; text-align: center; }
.field { padding: 16rpx 0; border-bottom: 1rpx solid #e7ecea; }
.field:last-child { border-bottom: 0; }
.field-label { display: block; margin-bottom: 10rpx; color: #435555; font-size: 25rpx; }
.input, .textarea, .field-picker {
  width: 100%;
  min-height: 68rpx;
  padding: 15rpx 16rpx;
  box-sizing: border-box;
  color: #233536;
  background: #f7f9f8;
  border: 1rpx solid #dce5e2;
  border-radius: 6rpx;
  font-size: 26rpx;
  line-height: 1.45;
}
.textarea { min-height: 156rpx; }
.field-picker { display: flex; align-items: center; }
.divider { height: 1rpx; margin: 20rpx 0; background: #e5ebe8; }
.range { margin-top: 12rpx; padding: 16rpx; background: #f7f9f8; border: 1rpx solid #e1e8e5; border-radius: 6rpx; }
.range-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 12rpx; }
.range-label { display: block; color: #647373; font-size: 22rpx; }
.range-date { display: block; margin-top: 6rpx; color: #233536; }
.notice-dot { display: inline-block; min-width: 14rpx; height: 14rpx; border-radius: 50%; background: #c74d4a; }
.record-title, .record-location, .record-time, .detail-copy, .muted { min-width: 0; overflow-wrap: anywhere; word-break: break-word; }
.record-top, .record-top > text { min-width: 0; }

.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.heading-title { display: block; color: #233536; font-size: 34rpx; line-height: 1.3; font-weight: 650; }
.compact-button, .small-button { min-height: 58rpx; padding: 0 18rpx; font-size: 24rpx; }
.pager { display: flex; align-items: center; justify-content: center; gap: 18rpx; padding: 20rpx 0; }
.pager-button { min-width: 128rpx; min-height: 58rpx; padding: 0 14rpx; font-size: 23rpx; }
.pager-text { color: #647373; font-size: 23rpx; }
.detail-copy { display: block; margin: 16rpx 0; line-height: 1.7; white-space: pre-wrap; }
