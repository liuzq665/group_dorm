<import src="../../templates/ui.wxml"/>
<view class="page">
  <view class="page-heading">
    <view class="grow">
      <text class="heading-title">消息中心</text>
      <text class="heading-sub">{{unread}} 条未读消息</text>
    </view>
    <view class="heading-actions">
      <button wx:if="{{unread}}" class="outline compact-button" bindtap="readAll">全部已读</button>
      <button wx:if="{{role==='ADMIN'||role==='DORM_MANAGER'}}" class="primary compact-button" bindtap="openPublish">发布</button>
    </view>
  </view>

  <view class="sticky-filter">
    <view class="tabs">
      <view wx:for="{{sourceOptions}}" wx:key="key" class="tab {{source===item.key?'active':''}}" data-key="{{item.key}}" bindtap="chooseSource">{{item.label}}</view>
    </view>
    <view class="filter-row">
      <view class="tabs read-tabs">
        <view wx:for="{{readOptions}}" wx:key="key" class="tab {{read===item.key?'active':''}}" data-key="{{item.key}}" bindtap="chooseRead">{{item.label}}</view>
      </view>
      <picker wx:if="{{role==='REPAIRER'}}" class="building-picker" range="{{buildings}}" range-key="building_name" value="{{buildingIndex}}" bindchange="chooseBuilding">
        <view class="filter-select">{{buildingLabel}}<text class="picker-arrow">⌄</text></view>
      </picker>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在加载消息…</view>
  <block wx:elif="{{!items.length}}">
    <template is="empty-state" data="{{...emptyView}}"/>
  </block>
  <block wx:else>
    <view class="record-list">
      <view wx:for="{{pageItems}}" wx:key="message_id" class="record-card message-card {{item.unread?'unread':''}}" data-item="{{item}}" bindtap="open">
        <view class="record-head">
          <text class="record-title">{{item.title}}</text>
          <text wx:if="{{item.unread}}" class="notice-dot"></text>
        </view>
        <view class="message-meta">
          <text class="tag tag-info">{{item.sourceLabel}}</text>
          <text class="message-publisher">发布人：{{item.publisherLabel}}</text>
        </view>
        <text class="record-meta message-content">{{item.content}}</text>
        <view class="record-foot">
          <text class="record-time">{{item.timeLabel}}</text>
          <text class="message-read">{{item.readLabel}}</text>
        </view>
      </view>
    </view>
    <template is="pager" data="{{...pager}}"/>
  </block>

  <!-- 消息详情 -->
  <view wx:if="{{detail}}" class="modal-mask">
    <view class="modal-panel">
      <view class="modal-head">
        <text class="section-title">消息详情</text>
        <text class="modal-close" bindtap="closeDetail">返回列表</text>
      </view>
      <view class="detail-title">{{detailView.title}}</view>
      <view wx:for="{{detailView.fields}}" wx:key="label">
        <template is="detail-field" data="{{...item}}"/>
      </view>
      <text class="field-label">正文</text>
      <text class="detail-copy">{{detailView.content}}</text>
      <text class="field-label">附件</text>
      <template is="attachment-list" data="{{...detailView}}"/>
    </view>
  </view>

  <!-- 发布通知（管理员/宿管） -->
  <view wx:if="{{publishing}}" class="modal-mask">
    <view class="modal-panel">
      <view class="modal-head">
        <text class="section-title">发布通知</text>
        <text class="modal-close" bindtap="closePublish">关闭</text>
      </view>
      <view class="field">
        <text class="field-label">通知标题</text>
        <input class="input" placeholder="请输入通知标题" data-key="title" value="{{form.title}}" bindinput="input"/>
      </view>
      <view class="field">
        <text class="field-label">通知内容</text>
        <textarea class="textarea" placeholder="请输入通知内容" data-key="content" value="{{form.content}}" bindinput="input"/>
      </view>
      <view class="field">
        <text class="field-label">接收对象</text>
        <view class="tabs">
          <view class="tab {{form.targetRole==='STUDENT'?'active':''}}" data-value="STUDENT" bindtap="target">学生</view>
          <view wx:if="{{role==='ADMIN'}}" class="tab {{form.targetRole==='DORM_MANAGER'?'active':''}}" data-value="DORM_MANAGER" bindtap="target">宿管</view>
          <view wx:if="{{role==='ADMIN'}}" class="tab {{form.targetRole==='REPAIRER'?'active':''}}" data-value="REPAIRER" bindtap="target">维修人员</view>
          <view wx:if="{{role==='ADMIN'}}" class="tab {{form.targetRole==='ADMIN'?'active':''}}" data-value="ADMIN" bindtap="target">管理员</view>
          <view wx:if="{{role==='ADMIN'}}" class="tab {{form.targetRole==='ALL'?'active':''}}" data-value="ALL" bindtap="target">全部角色</view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">楼栋范围（默认全部）</text>
        <checkbox-group class="building-options" bindchange="selectBuildings">
          <label wx:for="{{buildings}}" wx:key="building_id" class="building-option">
            <checkbox value="{{item.building_id}}" checked="{{item.selected}}"/>{{item.building_name}}
          </label>
        </checkbox-group>
      </view>
      <view class="field">
        <text class="field-label">附件（最多 8 个，可选）</text>
        <button class="outline compact-button" bindtap="chooseFiles">添加附件（{{files.length}}）</button>
        <text wx:for="{{files}}" wx:key="*this" class="file-row-text">{{item}}</text>
      </view>
      <view class="action-bar">
        <button class="outline" bindtap="closePublish">取消</button>
        <button class="primary" loading="{{actionBusy}}" disabled="{{actionBusy}}" bindtap="publish">发布</button>
      </view>
    </view>
  </view>
</view>
