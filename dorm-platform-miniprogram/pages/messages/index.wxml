<view class="page"><view class="row"><text class="section-title">消息</text><button class="outline small-button" bindtap="readAll">全部已读</button></view><view wx:if="{{loading}}" class="loading">正在加载消息…</view><view wx:elif="{{!items.length}}" class="empty">暂无消息</view><view wx:else class="message-item {{item.read_at?'':'unread'}}" wx:for="{{items}}" wx:key="message_id" data-item="{{item}}" bindtap="open"><view class="row"><text class="message-title">{{item.title}}</text><text wx:if="{{!item.read_at}}" class="notice-dot"></text></view><text class="message-content">{{item.content}}</text><text class="muted">{{item.delivered_at || item.created_at}}</text></view></view>
