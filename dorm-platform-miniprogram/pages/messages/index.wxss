.message-heading { align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.message-heading .section-title { margin: 0; }
.message-heading .muted { display: block; margin-top: 3rpx; }
.message-heading .button-row { flex: none; flex-wrap: nowrap; gap: 8rpx; margin: 0; }
.message-heading .small-button { min-height: 56rpx; padding: 0 12rpx; font-size: 21rpx; }
.message-filters { margin-bottom: 14rpx; padding: 12rpx; background: #fff; border: 1rpx solid #e1e8e5; border-radius: 6rpx; }
.message-source-tabs,.message-read-tabs { display: flex; flex-wrap: wrap; gap: 7rpx; }
.message-read-tabs { margin-top: 10rpx; padding-top: 10rpx; border-top: 1rpx solid #e8edeb; }
.message-source-tab,.message-read-tab { min-height: 48rpx; display: inline-flex; align-items: center; padding: 0 13rpx; color: #52635f; background: #f0f4f2; border-radius: 4rpx; font-size: 22rpx; }
.message-source-tab.selected,.message-read-tab.selected { color: #fff; background: #176d62; }
.building-filter { display: flex; justify-content: space-between; margin-top: 10rpx; padding: 10rpx 12rpx; color: #425652; background: #f7f9f8; border: 1rpx solid #dce5e2; border-radius: 5rpx; font-size: 23rpx; }
.message-item { margin-top: 10rpx; padding: 18rpx; background: #fff; border: 1rpx solid #e1e8e5; border-radius: 6rpx; }
.message-item.unread { border-left: 6rpx solid #b84d49; }
.message-item > .row { align-items: flex-start; }
.message-item > .row > view { flex: 1; min-width: 0; }
.message-title { display: block; color: #293d3a; font-size: 27rpx; line-height: 1.4; font-weight: 650; overflow-wrap: anywhere; }
.message-source { display: block; margin-top: 4rpx; color: #687673; font-size: 22rpx; line-height: 1.4; }
.message-content { display: block; margin: 10rpx 0; color: #435451; line-height: 1.6; overflow-wrap: anywhere; }
.message-buildings { display: block; margin-bottom: 8rpx; color: #586a66; font-size: 22rpx; white-space: pre-line; }
.message-item > .muted { display: block; margin-top: 7rpx; font-size: 22rpx; }
.attachment-list { display: flex; flex-direction: column; gap: 6rpx; margin: 10rpx 0; }
.attachment-button { max-width: 100%; margin: 0; padding: 0; color: #176b60; background: transparent; text-align: left; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.modal-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: center; justify-content: center; padding: 22rpx; box-sizing: border-box; background: rgba(20, 38, 36, .45); }
.publish-panel, .detail-panel { width: 100%; max-height: 88vh; overflow-y: auto; padding: 22rpx; box-sizing: border-box; background: #fff; border: 1rpx solid #dce5e2; border-radius: 8rpx; }
.publish-panel .section-title { margin: 0 0 10rpx; }
.publish-panel > .input, .publish-panel > .textarea { width: 100%; margin: 10rpx 0; }
.field-label { display: block; margin: 14rpx 0 7rpx; color: #435555; font-size: 24rpx; }
.building-options { max-height: 280rpx; overflow-y: auto; padding: 6rpx 12rpx; border: 1rpx solid #dce5e2; border-radius: 6rpx; }
.building-option { display: flex; align-items: center; min-height: 48rpx; color: #3d5350; font-size: 23rpx; }
.publish-submit { width: 100%; margin-top: 14rpx; }
.detail-heading { align-items: center; margin-bottom: 12rpx; }
.detail-heading .section-title { margin: 0; }
.detail-title { display: block; color: #263b39; font-size: 30rpx; line-height: 1.45; font-weight: 650; overflow-wrap: anywhere; }
.detail-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6rpx 14rpx; margin: 8rpx 0 16rpx; color: #687673; font-size: 22rpx; }
.detail-field { display: grid; grid-template-columns: 132rpx minmax(0, 1fr); gap: 12rpx; padding: 10rpx 0; border-bottom: 1rpx solid #e7ecea; }
.detail-field > text:last-child { min-width: 0; white-space: pre-line; word-break: break-word; }
.detail-body { padding: 16rpx 0; color: #3d504d; line-height: 1.65; white-space: pre-wrap; word-break: break-word; }
