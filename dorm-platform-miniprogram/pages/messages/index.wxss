.page-heading { align-items: flex-start; }
.heading-actions { display: flex; flex: none; gap: 8rpx; }
.heading-actions .compact-button { min-height: 56rpx; padding: 0 14rpx; font-size: 21rpx; }

.sticky-filter .tabs { flex: 1; min-width: 0; }
.read-tabs { flex: none; }
.building-picker { flex: none; width: 220rpx; }
.building-picker .filter-select { height: 52rpx; font-size: 21rpx; }
.picker-arrow { color: var(--text-3); font-size: 21rpx; }

.message-card { border-left: 5rpx solid transparent; }
.message-card.unread { border-left-color: var(--danger); }
.message-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.message-publisher { color: var(--text-3); font-size: 21rpx; }
.message-content {
  margin-top: 8rpx;
  color: var(--text-2);
  font-size: 22rpx;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.message-read { flex: none; color: var(--text-3); font-size: 21rpx; }

.detail-title { display: block; margin-bottom: 8rpx; color: var(--text-1); font-size: 28rpx; line-height: 1.45; font-weight: 600; overflow-wrap: anywhere; }
.detail-copy { display: block; margin: 8rpx 0 14rpx; color: #4a5a56; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }

.building-options { max-height: 280rpx; overflow-y: auto; padding: 8rpx 12rpx; border: 1rpx solid var(--border); border-radius: var(--radius-m); }
.building-option { display: flex; align-items: center; min-height: 52rpx; color: var(--text-2); font-size: 22rpx; }
.file-row-text { display: block; margin-top: 6rpx; color: var(--text-2); font-size: 21rpx; overflow-wrap: anywhere; }
