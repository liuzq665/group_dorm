.small-button { margin:20rpx 0 0; font-size:24rpx; line-height:56rpx; }.message-item { background:#fff; border-radius:20rpx; padding:26rpx; margin-top:18rpx; box-shadow:0 6rpx 18rpx rgba(21,55,57,.05); }.message-item.unread { border-left:8rpx solid #0C8075; }.message-title { font-size:31rpx; font-weight:700; }.message-content { display:block; color:#526566; margin:14rpx 0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
