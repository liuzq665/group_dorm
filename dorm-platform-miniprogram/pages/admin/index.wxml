<view class="page">
  <view class="page-heading"><view><text class="heading-title">系统管理</text><text class="muted">人员、维修规则与操作记录</text></view></view>
  <view class="segmented"><view class="segment {{tab==='people'?'selected':''}}" data-tab="people" bindtap="selectTab">人员角色</view><view class="segment {{tab==='repair'?'selected':''}}" data-tab="repair" bindtap="selectTab">维修规则</view><view class="segment {{tab==='logs'?'selected':''}}" data-tab="logs" bindtap="selectTab">操作日志</view><view class="segment {{tab==='backup'?'selected':''}}" data-tab="backup" bindtap="selectTab">数据备份</view></view>
  <view wx:if="{{loading}}" class="loading">正在加载系统数据…</view>
  <block wx:elif="{{tab==='people'}}">
    <view class="filter-row"><picker range="{{roleLabels}}" value="{{roleIndex}}" bindchange="roleChange"><view class="input">{{roleLabels[roleIndex]}}⌄</view></picker><input class="input" placeholder="姓名或账号" value="{{keyword}}" bindinput="keyword" confirm-type="search" bindconfirm="search"/><button class="outline small-button" bindtap="search">查询</button><button class="primary small-button" bindtap="createUser">新增</button></view>
    <view wx:if="{{!users.length}}" class="empty">没有匹配人员</view>
    <view wx:for="{{users}}" wx:key="user_id" class="record-row"><view class="record-top" data-id="{{item.user_id}}" bindtap="userDetail"><text class="record-title">{{item.real_name}}</text><text class="status {{item.enabled?'done':'danger'}}">{{item.enabled?'启用':'禁用'}}</text></view><text class="record-location">{{item.login_account}} · {{item.student_no || item.employee_no}} · {{item.phone || '未填写电话'}}</text><text wx:if="{{item.role_code==='STUDENT'}}" class="record-time">{{item.department_name}} {{item.major_name}} {{item.class_name}} · {{item.current_building || '未分配住宿'}} {{item.current_room || ''}} {{item.current_bed || ''}}</text><text wx:if="{{item.role_code==='DORM_MANAGER'}}" class="record-time">负责楼栋：{{item.manager_buildings || '未分配'}}</text><text wx:if="{{item.role_code==='REPAIRER'}}" class="record-time">工种：{{item.work_types || '未配置'}} · 楼栋：{{item.repairer_buildings || '未配置'}}</text><view class="button-row"><button wx:if="{{item.role_code==='DORM_MANAGER'||item.role_code==='REPAIRER'}}" class="secondary small-button" data-user="{{item}}" bindtap="configureScope">配置负责范围</button><button class="outline small-button" data-id="{{item.user_id}}" bindtap="editUser">编辑</button><button wx:if="{{item.user_id!==selfUserId}}" class="outline small-button" data-id="{{item.user_id}}" data-enabled="{{item.enabled}}" bindtap="enabled">{{item.enabled?'禁用':'启用'}}</button><button wx:if="{{item.user_id!==selfUserId}}" class="danger small-button" data-id="{{item.user_id}}" bindtap="deleteUser">删除</button></view></view>
  </block>
  <block wx:elif="{{tab==='repair' && config}}"><view class="card"><text class="section-inline">派单与时限规则</text><view class="field-row"><text>接单时限（分钟）</text><input class="input compact" type="number" data-key="accept_minutes" value="{{config.rule.accept_minutes}}" bindinput="ruleInput"/></view><view class="field-row"><text>普通维修时限（分钟）</text><input class="input compact" type="number" data-key="normal_minutes" value="{{config.rule.normal_minutes}}" bindinput="ruleInput"/></view><view class="field-row"><text>紧急维修时限（分钟）</text><input class="input compact" type="number" data-key="urgent_minutes" value="{{config.rule.urgent_minutes}}" bindinput="ruleInput"/></view><view class="field-row"><text>完工确认时限（天）</text><input class="input compact" type="number" data-key="confirm_days" value="{{config.rule.confirm_days}}" bindinput="ruleInput"/></view><button class="primary" bindtap="saveRule">保存规则版本</button></view><view class="section-title">维修人员范围</view><view wx:for="{{config.workers}}" wx:key="repairer_user_id" class="record-row"><view class="record-top"><text class="record-title">{{item.real_name}}</text><text class="status">{{item.on_duty?'在岗':'离岗'}}</text></view><text class="record-location">工种编号：{{item.workTypeIds}} · 楼栋编号：{{item.buildingIds}}</text></view></block>
  <block wx:elif="{{tab==='logs'}}"><view wx:if="{{!logs.length}}" class="empty">暂无操作日志</view><view wx:for="{{logs}}" wx:key="log_id" class="record-row"><view class="record-top"><text class="record-title">{{item.module_label}} · {{item.action}}</text><text class="status">{{item.role_label}}</text></view><text class="record-location">{{item.real_name || '系统'}} · {{item.occurred_at}}</text><text class="record-time">对象：{{item.target_id}}</text></view></block>
  <block wx:elif="{{tab==='backup'}}"><view class="backup-actions"><button class="outline small-button" data-type="roles" bindtap="createBackup">角色管理</button><button class="outline small-button" data-type="repairs" bindtap="createBackup">报修管理</button><button class="outline small-button" data-type="stays" bindtap="createBackup">留宿管理</button><button class="outline small-button" data-type="dorm" bindtap="createBackup">宿舍管理</button></view><view wx:if="{{!backups.length}}" class="empty">暂无备份记录</view><view wx:for="{{backups}}" wx:key="task_id" class="record-row"><view class="record-top"><text class="record-title">{{item.backup_domain}}</text><text class="status {{item.task_status==='SUCCESS'?'done':item.task_status==='FAILED'?'danger':'warning'}}">{{item.task_status==='SUCCESS'?'成功':item.task_status==='FAILED'?'失败':item.task_status==='RUNNING'?'执行中':'排队中'}}</text></view><text class="record-time">创建于 {{item.created_at}}</text><view class="button-row"><button wx:if="{{item.task_status==='SUCCESS'}}" class="outline small-button" data-id="{{item.task_id}}" bindtap="downloadBackup">下载 SQL</button><button class="danger small-button" data-id="{{item.task_id}}" bindtap="deleteBackup">删除记录</button></view></view></block>
</view>
