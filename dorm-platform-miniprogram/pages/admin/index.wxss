.page-heading { align-items: center; margin-bottom: 16rpx; }
.page-heading .muted { display: block; margin-top: 4rpx; }
.segmented { display: flex; gap: 4rpx; margin-bottom: 14rpx; padding: 4rpx; background: #e5ebe8; border-radius: 6rpx; }
.segment { min-width: 0; flex: 1; padding: 11rpx 3rpx; color: #5a6a66; text-align: center; font-size: 22rpx; line-height: 1.35; }
.segment.selected { color: #fff; background: #286f61; border-radius: 4rpx; font-weight: 600; }
.filter-row { display: flex; align-items: center; gap: 8rpx; margin-bottom: 12rpx; }
.filter-row picker { width: 164rpx; flex: none; }
.filter-row .input { min-width: 0; min-height: 62rpx; padding: 12rpx; font-size: 22rpx; }
.filter-row button { min-width: 80rpx; min-height: 62rpx; flex: none; padding: 0 12rpx; font-size: 23rpx; }
.record-row { margin-bottom: 10rpx; padding: 17rpx; background: #fff; border: 1rpx solid #e1e8e5; border-radius: 6rpx; }
.record-top, .field-row { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.record-title { flex: 1; color: #293d3a; font-size: 26rpx; line-height: 1.4; font-weight: 650; overflow-wrap: anywhere; }
.record-location, .record-time { display: block; margin-top: 6rpx; color: #62716e; font-size: 22rpx; line-height: 1.45; overflow-wrap: anywhere; }
.field-row { min-height: 70rpx; padding: 10rpx 0; color: #3b4d49; font-size: 24rpx; border-bottom: 1rpx solid #e7ecea; }
.input.compact { width: 190rpx; min-width: 190rpx; min-height: 58rpx; text-align: right; }
.backup-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8rpx; margin-bottom: 12rpx; }
.backup-actions button { min-width: 0; min-height: 60rpx; padding: 0 8rpx; font-size: 22rpx; }
