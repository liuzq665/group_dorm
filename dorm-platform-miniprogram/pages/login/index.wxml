<view class="page login-page">
  <view class="login-mark">宿</view>
  <text class="login-title">宿舍事务</text>
  <text class="login-copy">学生服务小程序</text>
  <view class="form-card login-form">
    <view class="field"><text class="field-label">账号</text><input class="input" value="{{account}}" data-key="account" bindinput="input" placeholder="请输入账号" /></view>
    <view class="field"><text class="field-label">密码</text><input class="input" password value="{{password}}" data-key="password" bindinput="input" placeholder="请输入密码" /></view>
    <button class="primary login-button" loading="{{submitting}}" bindtap="login">登录</button>
  </view>
  <text class="login-tip">登录状态失效后将自动返回此页</text>
</view>
