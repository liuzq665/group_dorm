.login-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
  padding: 56rpx 40rpx 72rpx;
}
.login-brand { display: flex; flex-direction: column; align-items: flex-start; }
.login-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--brand-600);
  border-radius: var(--radius-l);
  font-size: 40rpx;
  font-weight: 650;
}
.login-title { display: block; margin-top: 22rpx; color: var(--text-1); font-size: 40rpx; line-height: 1.3; font-weight: 650; }
.login-copy { display: block; margin-top: 8rpx; color: var(--text-2); font-size: 24rpx; line-height: 1.6; }
.login-form { margin-top: 32rpx; padding: 28rpx 24rpx; }
.login-form .input { min-height: 76rpx; }
.login-form .action-bar { margin-top: 24rpx; }
.login-error { display: block; margin-top: 12rpx; color: var(--danger); font-size: 22rpx; line-height: 1.5; }
.login-tip { display: block; margin-top: 24rpx; color: var(--text-3); text-align: center; font-size: 22rpx; line-height: 1.6; }

