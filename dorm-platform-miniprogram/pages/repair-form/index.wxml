<view class="page"><view wx:if="{{loading}}" class="loading">正在准备表单…</view><view wx:else class="form-card"><view class="field"><text class="field-label">故障分类</text><picker mode="selector" range="{{catalog.categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="field-picker">{{catalog.categories[categoryIndex].name || '请选择分类'}}</view></picker></view><view class="field"><text class="field-label">报修标题</text><input class="input" value="{{form.title}}" data-key="title" bindinput="input" maxlength="100" placeholder="例如：卫生间水龙头漏水" /></view><view class="field"><text class="field-label">故障位置与说明</text><textarea class="textarea" value="{{form.description}}" data-key="description" bindinput="input" maxlength="1000" placeholder="请说明问题位置、现象和是否影响使用" /></view><view class="field"><text class="field-label">现场照片（可选）</text><view class="button-row"><button class="outline" bindtap="choose">选择照片</button><text class="muted">已选 {{files.length}} 张</text></view><view class="file-row" wx:for="{{files}}" wx:key="*this"><text>{{item}}</text><text class="file-remove" data-index="{{index}}" bindtap="remove">移除</text></view></view><view class="button-row"><button class="secondary" bindtap="save" data-submit="false">保存草稿</button><button class="primary" bindtap="save" data-submit="true">提交审核</button></view></view></view>
