<view class="page"><view wx:if="{{loading}}" class="loading">正在准备留宿申请…</view><view wx:else class="form-card"><view class="card-hint"><text class="section-inline">{{batch.batch_name}}</text><text class="muted">可申请：{{batch.open_start_date}} 至 {{batch.open_end_date}}</text></view><view class="field"><text class="field-label">留宿日期段</text><view class="range" wx:for="{{ranges}}" wx:key="index"><view class="row"><text>第 {{index + 1}} 段</text><text class="file-remove" data-index="{{index}}" bindtap="removeRange">移除</text></view><view class="range-grid"><picker mode="date" value="{{item.startDate}}" data-index="{{index}}" data-key="startDate" bindchange="date"><view><text class="range-label">开始</text><text class="range-date">{{item.startDate || '选择日期'}}</text></view></picker><picker mode="date" value="{{item.endDate}}" data-index="{{index}}" data-key="endDate" bindchange="date"><view><text class="range-label">结束</text><text class="range-date">{{item.endDate || '选择日期'}}</text></view></picker></view></view><button class="outline" bindtap="addRange">添加时间段</button></view><view class="field"><text class="field-label">留宿原因</text><textarea class="textarea" value="{{reason}}" bindinput="reason" placeholder="请如实填写留宿原因" /></view><view class="field"><text class="field-label">申请材料（最多 8 个，可选）</text><button class="outline" bindtap="choose">选择材料（{{files.length}}）</button></view><view class="button-row"><button class="secondary" data-submit="false" bindtap="save">保存草稿</button><button class="primary" data-submit="true" bindtap="save">提交审核</button></view></view></view>
