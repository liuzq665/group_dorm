<view class="page"><view wx:if="{{loading}}" class="loading">正在加载申请…</view><view wx:elif="{{!detail}}" class="empty">未找到该留宿申请</view><block wx:else><view class="hero"><text class="hero-kicker">{{detail.batch_name}}</text><text class="hero-title">{{detail.statusLabel}}</text><text class="hero-copy">{{detail.dateRangeText}}</text></view><view class="card"><view class="row"><text class="label">申请学生</text><text>{{detail.student_name || '我'}}</text></view><view class="row"><text class="label">留宿原因</text><text>{{detail.reason}}</text></view><view class="row"><text class="label">审核意见</text><text>{{detail.review_reason || '-'}}</text></view><view class="row"><text class="label">重交截止</text><text>{{detail.resubmit_deadline || '-'}}</text></view><view class="row"><text class="label">最近撤回</text><text>{{detail.withdraw_count || 0}} 次</text></view></view><view class="card" wx:if="{{detail.attachments.length}}"><text class="section-inline">申请附件</text><view class="row" wx:for="{{detail.attachments}}" wx:key="file_id" data-file="{{item}}" bindtap="preview"><text>{{item.original_name}}</text><text class="link">预览</text></view></view><view class="card" wx:if="{{detail.reviews.length}}"><text class="section-inline">审核记录</text><view class="row" wx:for="{{detail.reviews}}" wx:key="review_id"><text>{{item.result}} · {{item.reason || '-'}}</text><text class="muted">{{item.reviewed_at}}</text></view></view><view class="button-row"><button wx:if="{{role==='STUDENT' && (detail.current_status==='DRAFT'||detail.current_status==='PENDING_EDIT')}}" class="secondary" bindtap="edit">修改申请</button><button wx:if="{{role==='STUDENT' && (detail.current_status==='DRAFT'||detail.current_status==='PENDING_EDIT')}}" class="primary" bindtap="submit">提交审核</button><button wx:if="{{role==='STUDENT' && detail.current_status==='PENDING_REVIEW'}}" class="danger" bindtap="withdraw">撤回申请</button></view></block></view>
