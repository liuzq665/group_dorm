<import src="../../templates/ui.wxml"/>
<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载留宿申请…</view>
  <view wx:elif="{{!detail}}" class="empty-state"><text class="empty-title">未找到该留宿申请</text><text class="empty-tip">请返回列表刷新后重试</text></view>
  <block wx:else>
    <view class="hero">
      <text class="hero-kicker">{{detail.batch_name}}</text>
      <text class="hero-title">{{detail.statusLabel}}</text>
      <text class="hero-copy">{{detail.dateRangeText}}</text>
    </view>

    <view class="card">
      <text class="section-inline">申请信息</text>
      <view class="divider"></view>
      <view wx:for="{{rows}}" wx:key="label">
        <template is="detail-field" data="{{...item}}"/>
      </view>
    </view>

    <view class="card">
      <view class="section-heading"><text class="section-inline">申请附件</text><text class="muted">{{attachmentView.files.length}} 个</text></view>
      <template is="attachment-list" data="{{...attachmentView}}"/>
    </view>

    <view wx:if="{{reviews.length}}" class="card">
      <view class="section-heading"><text class="section-inline">审核记录</text><text class="muted">{{reviews.length}} 条</text></view>
      <view class="log-item" wx:for="{{reviews}}" wx:key="review_id">
        <text class="log-title">{{item.title}}</text>
        <text class="log-time">{{item.timeLabel}}</text>
      </view>
    </view>

    <view wx:if="{{detail.canEdit || detail.canWithdraw}}" class="action-bar">
      <button wx:if="{{detail.canEdit}}" class="secondary" bindtap="edit">修改申请</button>
      <button wx:if="{{detail.canSubmit}}" class="primary" loading="{{actionBusy}}" disabled="{{actionBusy}}" bindtap="submit">提交审核</button>
      <button wx:if="{{detail.canWithdraw}}" class="danger" loading="{{actionBusy}}" disabled="{{actionBusy}}" bindtap="withdraw">撤回申请</button>
    </view>
  </block>
</view>
