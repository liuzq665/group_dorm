.repairer-hero { background: #42596b; border-left: 6rpx solid rgba(255, 255, 255, .3); }
.picker-arrow { color: var(--text-3); font-size: 21rpx; }
.filter-row .filter-action { flex: none; min-height: 62rpx; padding: 0 16rpx; font-size: 21rpx; }
.sticky-filter .tabs { margin-top: 10rpx; }
.filter-note { display: block; margin: 0 0 10rpx; color: var(--text-3); font-size: 21rpx; }
.collapse-empty { padding: 24rpx 0; color: var(--text-2); text-align: center; font-size: 22rpx; }
.score-chip {
  flex: none;
  padding: 2rpx 10rpx;
  color: var(--warning);
  background: var(--warning-bg);
  border-radius: var(--radius-s);
  font-size: 20rpx;
  font-weight: 650;
}
.comment-clamp {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.rating-total { display: flex; align-items: baseline; gap: 6rpx; padding: 8rpx 0 14rpx; }
.rating-number { color: var(--brand-600); font-size: 56rpx; line-height: 1.1; font-weight: 700; }
.rating-unit { color: var(--text-3); font-size: 22rpx; }
.rating-trend { display: flex; flex-direction: column; gap: 14rpx; }
.rating-row { display: grid; grid-template-columns: 90rpx minmax(0, 1fr) 62rpx 66rpx; align-items: center; gap: 10rpx; }
.rating-period { color: var(--text-2); font-size: 21rpx; }
.rating-track { height: 10rpx; overflow: hidden; background: #eef2f1; border-radius: 6rpx; }
.rating-bar { height: 100%; background: #c2a76a; border-radius: 6rpx; }
.rating-score { color: #7a6547; text-align: right; font-size: 21rpx; font-weight: 650; }
.rating-count { color: var(--text-3); text-align: right; font-size: 20rpx; }
