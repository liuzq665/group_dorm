<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载维修统计…</view>
  <block wx:else>
    <view class="hero repairer-stats-hero">
      <text class="hero-kicker">维修人员工作台</text>
      <text class="hero-title">{{profile.real_name || '个人维修统计'}}</text>
      <text class="hero-copy">工单与评价统计</text>
    </view>
    <view class="metric-grid stats-grid">
      <view class="metric-card"><text class="metric-number">{{stats.current || 0}}</text><text class="metric-label">当前工单</text></view>
      <view class="metric-card"><text class="metric-number">{{stats.completed || 0}}</text><text class="metric-label">累计完工</text></view>
      <view class="metric-card"><text class="metric-number">{{stats.averageScore || 0}}</text><text class="metric-label">综合评分 / 5</text></view>
      <view class="metric-card"><text class="metric-number">{{stats.evaluations || 0}}</text><text class="metric-label">收到评价</text></view>
      <view class="metric-card"><text class="metric-number">{{stats.acceptTimeout || 0}}</text><text class="metric-label">接单超时</text></view>
      <view class="metric-card"><text class="metric-number">{{stats.repairTimeout || 0}}</text><text class="metric-label">维修超时</text></view>
    </view>
    <view class="rating-panel">
      <view class="section-heading"><text class="section-inline">综合评价趋势</text><text class="muted">{{stats.ratingSummary.averageScore || 0}} / 5</text></view>
      <view wx:if="{{ratingTrend.length}}" class="rating-trend-row" wx:for="{{ratingTrend}}" wx:key="label"><text class="rating-period">{{item.label}}</text><view class="rating-track"><view class="rating-bar" style="width:{{item.barWidth}}"></view></view><text class="rating-score">{{item.scoreLabel}}</text></view>
      <text wx:if="{{!ratingTrend.length}}" class="muted">暂无评价数据</text>
    </view>
    <view wx:for="{{sections}}" wx:key="key" class="stats-section">
      <view class="section-heading"><text class="section-inline">{{item.title}}</text><text class="muted">{{item.items.length}} 条</text></view>
      <view wx:if="{{!item.items.length}}" class="empty compact-empty">暂无记录</view>
      <view wx:else class="record-list">
        <view wx:for="{{item.items}}" wx:for-item="record" wx:key="order_id" class="record-row stats-record" data-id="{{record.order_id}}" bindtap="openRecord">
          <text class="record-title">{{record.displayTitle}}</text>
          <text class="record-location">{{record.displayMeta}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
