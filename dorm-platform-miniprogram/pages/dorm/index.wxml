<view class="page">
  <view class="page-heading"><view><text class="heading-title">{{role==='ADMIN'?'宿舍资源管理':'负责楼栋'}}</text><text class="muted">楼栋、宿舍与床位</text></view><button wx:if="{{role==='ADMIN'}}" class="primary small-button" bindtap="create">新增</button></view>
  <view class="segmented"><view class="segment {{tab==='buildings'?'selected':''}}" data-tab="buildings" bindtap="selectTab">楼栋</view><view class="segment {{tab==='rooms'?'selected':''}}" data-tab="rooms" bindtap="selectTab">宿舍</view><view class="segment {{tab==='beds'?'selected':''}}" data-tab="beds" bindtap="selectTab">床位</view></view>
  <view wx:if="{{role==='ADMIN' && tab==='beds'}}" class="button-row"><button class="secondary" bindtap="assign">住宿分配</button></view>
  <view wx:if="{{loading}}" class="loading">正在加载资源…</view>
  <view wx:elif="{{tab==='buildings'}}" class="record-list"><view wx:for="{{buildings}}" wx:key="building_id" class="record-row" data-row="{{item}}" bindtap="showDetail"><view class="record-top"><text class="record-title">{{item.building_name}}</text><text class="status">{{item.gender_limit}}</text></view><text class="record-location">{{item.address}}</text><text class="record-time">{{item.room_count || 0}} 间宿舍 · {{item.available_bed_count || 0}} / {{item.bed_count || 0}} 空闲床位</text></view></view>
  <view wx:elif="{{tab==='rooms'}}" class="record-list"><view wx:for="{{rooms}}" wx:key="room_id" class="record-row" data-row="{{item}}" bindtap="showDetail"><view class="record-top"><text class="record-title">{{item.building_name}} {{item.room_no}}</text><text class="status">{{item.floor_no}} 层</text></view><text class="record-location">{{item.gender_limit}} · 容量 {{item.design_capacity}}</text><text class="record-time">{{item.available_bed_count || 0}} / {{item.bed_count || 0}} 空闲床位</text></view></view>
  <view wx:else class="record-list"><view wx:for="{{beds}}" wx:key="bed_id" class="record-row" data-row="{{item}}" bindtap="showDetail"><view class="record-top"><text class="record-title">{{item.building_name}} {{item.room_no}} · {{item.bed_no}}</text><text class="status {{item.student_name?'warning':'done'}}">{{item.student_name || '空床'}}</text></view><text class="record-location">{{item.floor_no}} 层 · {{item.gender_limit}} · {{item.management_status==='AVAILABLE'?'启用':'停用'}}</text><text wx:if="{{item.student_name}}" class="record-time">{{item.student_no}} · {{item.student_gender==='MALE'?'男':'女'}}</text></view></view>
  <view wx:if="!loading && tab==='buildings' && !buildings.length" class="empty">暂无楼栋</view><view wx:if="!loading && tab==='rooms' && !rooms.length" class="empty">暂无宿舍</view><view wx:if="!loading && tab==='beds' && !beds.length" class="empty">暂无床位</view>
</view>
