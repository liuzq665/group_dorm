<view class="page"><view wx:if="{{loading}}" class="loading">正在加载工单…</view><block wx:elif="{{detail}}"><view class="hero"><text class="hero-kicker">{{detail.order_no}}</text><text class="hero-title">{{detail.title}}</text><view class="button-row"><text class="status {{detail.statusStyle}}">{{detail.statusLabel}}</text></view></view><view class="card"><text class="section-inline">故障说明</text><text class="detail-copy">{{detail.description}}</text><view class="divider"></view><view class="row"><text class="label">处理人员</text><text>{{detail.repairer_name || '等待派单'}}</text></view><view class="row"><text class="label">维修结果</text><text>{{detail.result_text || '暂未提交'}}</text></view><view class="row"><text class="label">审核意见</text><text>{{detail.reject_reason || '-'}}</text></view></view><view class="card" wx:if="{{detail.audits.length}}"><text class="section-inline">处理记录</text><view class="row" wx:for="{{detail.audits}}" wx:key="audit_id"><text>{{item.result}} · {{item.reason || '-'}}</text><text class="muted">{{item.created_at}}</text></view></view><view class="button-row"><button wx:if="{{detail.current_status==='DRAFT'||detail.current_status==='PENDING_EDIT'}}" class="secondary" bindtap="edit">编辑</button><button wx:if="{{detail.current_status==='DRAFT'||detail.current_status==='PENDING_EDIT'}}" class="primary" data-action="submit" bindtap="simple">提交审核</button><button wx:if="{{detail.current_status==='DRAFT'||detail.current_status==='PENDING_EDIT'||detail.current_status==='PENDING_REVIEW'||detail.current_status==='PENDING_ASSIGN'||detail.current_status==='PENDING_MANUAL'}}" class="danger" data-action="cancel" bindtap="simple">撤销</button><button wx:if="{{detail.current_status==='CANCELLED'}}" class="primary" data-action="resubmit" bindtap="simple">重新提交</button><button wx:if="{{detail.current_status==='REPAIRED'}}" class="secondary" data-action="confirm" bindtap="simple">确认维修完成</button><button wx:if="{{detail.current_status==='REPAIRED'}}" class="outline" bindtap="rework">申请重修</button><button wx:if="{{detail.current_status==='CONFIRMED'}}" class="primary" bindtap="evaluate">评价</button></view></block></view>
