<import src="../../templates/ui.wxml"/>
<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载住宿信息…</view>
  <block wx:else>
    <view class="page-heading">
      <view class="grow">
        <text class="heading-title">住宿管理</text>
        <text class="heading-sub">我的住宿、舍友与住宿历史</text>
      </view>
    </view>

    <view wx:if="{{home}}" class="hero">
      <text class="hero-kicker">我的床位</text>
      <text class="hero-title">{{home.building_name}}</text>
      <text class="hero-copy">{{home.room_no}} 宿舍 · {{home.bed_no}} 床 · 入住于 {{home.check_in_date}}</text>
    </view>
    <view wx:else class="empty-state">
      <text class="empty-title">暂未分配床位</text>
      <text class="empty-tip">请联系系统管理员安排住宿</text>
    </view>

    <view wx:if="{{home}}" class="card">
      <text class="section-inline">当前住宿</text>
      <view class="divider"></view>
      <view wx:for="{{currentRows}}" wx:key="label">
        <template is="detail-field" data="{{...item}}"/>
      </view>
      <view class="action-bar">
        <button class="outline" bindtap="goRepairs">报修本宿舍</button>
      </view>
    </view>

    <view class="card">
      <view class="section-heading"><text class="section-inline">舍友</text><text class="muted">{{roommates.length}} 人</text></view>
      <view wx:if="{{roommates.length}}" class="roommate-list">
        <view class="row roommate-row" wx:for="{{roommates}}" wx:key="student_id">
          <text class="roommate-name">{{item.student_name}}</text>
          <text class="muted">{{item.bed_no}} 床</text>
        </view>
      </view>
      <text wx:else class="collapse-empty">当前没有可显示的舍友信息</text>
    </view>

    <view class="card">
      <view class="section-heading"><text class="section-inline">住宿历史</text><text class="muted">{{historyCount}} 条</text></view>
      <template wx:if="{{!historyRows.length}}" is="empty-state" data="{{...emptyHistory}}"/>
      <view wx:else class="record-list">
        <view class="record-card" wx:for="{{historyRows}}" wx:key="assignment_id">
          <view class="record-head">
            <text class="record-title">{{item.title}}</text>
            <text class="tag tag-muted">{{item.typeLabel}}</text>
          </view>
          <text class="record-meta">住宿期间：{{item.rangeLabel}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
