.hero { margin-bottom: 16rpx; }
.record-row { margin-top: 10rpx; padding: 18rpx; background: #fff; border: 1rpx solid #e1e8e5; border-radius: 6rpx; }
.record-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.record-title { min-width: 0; color: #293d3a; font-size: 27rpx; font-weight: 650; }
.record-location, .record-time { display: block; margin-top: 8rpx; color: #62716e; font-size: 23rpx; line-height: 1.45; overflow-wrap: anywhere; }
