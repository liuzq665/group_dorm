.hero { margin-bottom: 16rpx; }
.roommate-list { display: flex; flex-direction: column; }
.roommate-row { padding: 12rpx 0; border-bottom: 1rpx solid var(--divider); }
.roommate-row:last-child { border-bottom: 0; }
.roommate-name { min-width: 0; color: var(--text-1); font-size: 26rpx; word-break: break-word; }
.collapse-empty { padding: 24rpx 0; color: var(--text-2); text-align: center; font-size: 22rpx; }

