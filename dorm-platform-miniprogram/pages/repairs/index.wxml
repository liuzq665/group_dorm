<view class="page">
  <view wx:if="{{role==='STUDENT'}}" class="page-heading"><view><text class="heading-title">我的报修</text><text class="muted">查看处理进度与维修记录</text></view><button class="primary compact-button" bindtap="create">新建</button></view>
  <view wx:else class="page-heading"><view><text class="heading-title">{{role==='REPAIRER'?'维修任务':role==='DORM_MANAGER'?'楼栋报修':'全校报修'}}</text><text class="muted">{{role==='REPAIRER'?'只显示派给本人的工单':role==='DORM_MANAGER'?'仅显示负责楼栋范围':'按工单状态处理业务'}}</text></view></view>
  <view class="status-tabs"><view class="status-tab-list"><view wx:for="{{tabs}}" wx:key="key" class="status-tab {{item.selected?'active':''}}" data-tab="{{item.key}}" bindtap="chooseTab">{{item.label}}</view></view></view>
  <view class="search-strip"><input class="search-input" value="{{filters.keyword}}" bindinput="keyword" placeholder="按工单号搜索" confirm-type="search" bindconfirm="search"/><button class="outline search-button" bindtap="search">查询</button></view>
  <view wx:if="{{loading}}" class="loading">正在加载工单…</view>
  <view wx:elif="{{!items.length}}" class="empty">当前分类暂无工单</view>
  <view wx:else class="record-list">
    <view class="record-row" wx:for="{{pageItems}}" wx:key="order_id" data-id="{{item.order_id}}" bindtap="detail">
      <view class="record-top"><text class="record-title">{{item.title}}</text><text class="status {{item.statusStyle}}">{{item.statusLabel}}</text></view>
      <text class="record-no">{{item.order_no}} · {{item.category_name || '未分类'}}</text>
      <text wx:if="{{role!=='STUDENT'}}" class="record-location">{{item.building_name}} {{item.room_no}} · {{item.student_name}}</text>
      <text wx:if="{{role==='REPAIRER'}}" class="record-location">{{item.current_status==='PENDING_ACCEPT'?'请查看详情并决定是否接单':item.repair_deadline?'维修期限：'+item.repair_deadline:'待处理维修任务'}}</text>
      <text wx:if="{{role==='ADMIN' && item.dispatchText}}" class="dispatch-hint">{{item.dispatchText}}</text>
      <text class="record-time">更新于 {{item.updated_at}}</text>
    </view>
    <view wx:if="{{items.length>pageSize}}" class="pager"><button class="outline pager-button" data-delta="-1" bindtap="changePage" disabled="{{page===1}}">上一页</button><text class="pager-text">{{page}} / {{pageCount}}</text><button class="outline pager-button" data-delta="1" bindtap="changePage" disabled="{{page===pageCount}}">下一页</button></view>
  </view>
</view>
