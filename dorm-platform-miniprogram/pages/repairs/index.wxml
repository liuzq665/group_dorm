<view class="page"><view class="row"><view class="tabs"><text class="tab {{tab==='current'?'active':''}}" data-tab="current" bindtap="tab">进行中</text><text class="tab {{tab==='history'?'active':''}}" data-tab="history" bindtap="tab">历史记录</text></view><button class="primary new-button" bindtap="create">新建报修</button></view><view wx:if="{{loading}}" class="loading">正在加载报修…</view><view wx:elif="{{!items.length}}" class="empty">{{tab==='current'?'暂时没有进行中的报修':'暂无历史报修记录'}}</view><view wx:else class="repair-item" wx:for="{{items}}" wx:key="order_id" data-id="{{item.order_id}}" bindtap="detail"><view class="row"><text class="repair-title">{{item.title}}</text><text class="status {{item.statusStyle}}">{{item.statusLabel}}</text></view><text class="muted">{{item.order_no}} · {{item.category_name || '未分类'}}</text><text class="muted">{{item.building_name}} {{item.room_no}} · {{item.updated_at}}</text></view></view>
