<import src="../../templates/ui.wxml"/>
<view class="page">
  <view class="page-heading">
    <view class="grow">
      <text class="heading-title">{{title}}</text>
      <text class="heading-sub">{{sub}}</text>
    </view>
    <button wx:if="{{role==='STUDENT'}}" class="primary compact-button" bindtap="create">新建</button>
  </view>

  <view class="sticky-filter">
    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="tab {{item.selected?'active':''}}" data-tab="{{item.key}}" bindtap="chooseTab">
        {{item.label}}<text class="tab-count">{{item.count}}</text>
      </view>
    </view>
    <view class="filter-bar list-search">
      <input class="filter-input" value="{{filters.keyword}}" bindinput="keyword" placeholder="按工单号查询" confirm-type="search" bindconfirm="search"/>
      <button class="outline filter-action" bindtap="search">查询</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在加载工单…</view>
  <block wx:elif="{{!items.length}}">
    <template is="empty-state" data="{{...emptyView}}"/>
  </block>
  <block wx:else>
    <text class="list-summary">共 {{items.length}} 条 · 第 {{page}} / {{pageCount}} 页</text>
    <view class="record-list">
      <view wx:for="{{pageItems}}" wx:key="order_id" class="record-card" data-id="{{item.order_id}}" bindtap="detail">
        <view class="record-head">
          <text class="record-title">{{item.title}}</text>
          <text class="tag {{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <text class="record-meta">{{item.orderNoLabel}} · {{item.categoryLabel}}</text>
        <text wx:if="{{role!=='STUDENT'}}" class="record-meta">{{item.positionLabel}} · {{item.studentLabel}}</text>
        <text wx:if="{{role==='STUDENT' && item.repairer_name}}" class="record-meta">维修人员：{{item.repairerLabel}}</text>
        <text wx:if="{{role==='REPAIRER' && item.deadlineLabel}}" class="record-meta">{{item.deadlineLabel}}</text>
        <text wx:if="{{role==='REPAIRER' && !item.deadlineLabel && item.acceptDeadlineLabel}}" class="record-meta">{{item.acceptDeadlineLabel}}</text>
        <text wx:if="{{item.confirmHint}}" class="record-note">{{item.confirmHint}}</text>
        <text wx:if="{{item.acceptHint}}" class="record-note">{{item.acceptHint}}</text>
        <text wx:if="{{item.delayHint}}" class="record-note">{{item.delayHint}}</text>
        <text wx:if="{{item.dispatchHint}}" class="record-note">{{item.dispatchHint}}</text>
        <view class="record-foot">
          <view class="record-foot-left">
            <text wx:if="{{item.scoreLabel}}" class="score-chip">★ {{item.scoreLabel}}</text>
            <text class="record-time">更新于 {{item.timeLabel}}</text>
          </view>
          <text class="record-more">查看详情 ›</text>
        </view>
      </view>
    </view>
    <template is="pager" data="{{...pager}}"/>
  </block>
</view>
