.sticky-filter .tabs + .list-search { margin-top: 10rpx; }
.list-search .filter-input { height: 62rpx; }
.list-search .filter-action { min-height: 62rpx; }
.list-summary { display: block; margin: 4rpx 0 10rpx; color: var(--text-3); font-size: 21rpx; }
.record-more { flex: none; color: var(--brand-600); font-size: 22rpx; }
.record-foot-left { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.score-chip {
  flex: none;
  padding: 2rpx 10rpx;
  color: var(--warning);
  background: var(--warning-bg);
  border-radius: var(--radius-s);
  font-size: 20rpx;
  font-weight: 650;
}
