.page-heading { align-items: center; }
.page-heading .muted { display: block; margin-top: 4rpx; }
.status-tabs { width: 100%; height: auto; margin: 4rpx 0 16rpx; white-space: normal; }
.status-tab-list { display: flex; flex-wrap: wrap; gap: 8rpx; }
.status-tab {
  min-height: 52rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  box-sizing: border-box;
  color: #52625f;
  background: #e7ecea;
  border: 1rpx solid transparent;
  border-radius: 5rpx;
  font-size: 23rpx;
  white-space: nowrap;
}
.status-tab.active { color: #fff; background: #236f62; }
.search-strip { display: flex; align-items: center; gap: 10rpx; margin: 0 0 14rpx; }
.search-input { flex: 1; min-width: 0; height: 66rpx; padding: 0 16rpx; box-sizing: border-box; background: #fff; border: 1rpx solid #dce5e2; border-radius: 6rpx; font-size: 25rpx; }
.search-button { width: 116rpx; min-height: 66rpx; flex: none; padding: 0 10rpx; }
.record-list { display: flex; flex-direction: column; gap: 10rpx; }
.record-row { min-width: 0; padding: 18rpx 20rpx; background: #fff; border: 1rpx solid #e1e8e5; border-radius: 6rpx; }
.record-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.record-title { flex: 1; color: #263b39; font-size: 27rpx; line-height: 1.4; font-weight: 650; }
.record-no, .record-location, .record-time, .dispatch-hint { display: block; margin-top: 7rpx; color: #5f706d; font-size: 23rpx; line-height: 1.45; overflow-wrap: anywhere; }
.record-no { color: #3e625b; }
.dispatch-hint { padding: 8rpx 10rpx; color: #775323; background: #f7f0e3; border-radius: 4rpx; }
.record-row .status { margin-top: 1rpx; }
