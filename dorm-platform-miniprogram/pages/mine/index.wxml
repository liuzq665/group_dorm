<view class="page"><view wx:if="{{loading}}" class="loading">正在加载个人信息…</view><block wx:else><view class="hero"><text class="hero-kicker">学生档案</text><text class="hero-title">{{profile.real_name}}</text><text class="hero-copy">{{profile.student_no}} · {{profile.class_name || '未绑定班级'}}</text></view><view class="card"><view class="row"><text class="section-inline">个人资料</text><button wx:if="{{!editing}}" class="outline small-button" bindtap="toggleEdit">编辑</button></view><block wx:if="{{!editing}}"><view class="row"><text class="label">账号</text><text>{{profile.login_account}}</text></view><view class="row"><text class="label">联系电话</text><text>{{profile.phone || '未填写'}}</text></view><view class="row"><text class="label">学院 / 专业</text><text>{{profile.department_name || '-'}} / {{profile.major_name || '-'}}</text></view><view class="row"><text class="label">当前状态</text><text>{{profile.enrollment_status || '未登记'}}</text></view></block><block wx:else><view class="field"><text class="field-label">联系电话</text><input class="input" value="{{form.phone}}" data-key="phone" bindinput="input" placeholder="请输入联系电话" /></view><view class="field"><text class="field-label">性别</text><picker mode="selector" range="{{genderOptions}}" bindchange="genderChange"><view class="field-picker">{{form.gender || '未填写'}}</view></picker></view><view class="field"><text class="field-label">生日</text><picker mode="date" value="{{form.birthDate}}" bindchange="birthChange"><view class="field-picker">{{form.birthDate || '请选择生日'}}</view></picker></view><view class="button-row"><button class="primary" bindtap="save">保存资料</button><button class="secondary" bindtap="cancelEdit">取消</button></view></block></view><view class="form-card"><text class="section-inline">修改密码</text><view class="field"><input class="input" password placeholder="原密码" data-key="oldPassword" bindinput="passwordInput" /></view><view class="field"><input class="input" password placeholder="新密码（至少 6 位）" data-key="newPassword" bindinput="passwordInput" /></view><button class="outline full-button" bindtap="changePassword">更新密码</button></view><button class="danger logout-button" bindtap="logout">退出登录</button></block></view>
