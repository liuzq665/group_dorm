<import src="../../templates/ui.wxml"/>
<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载个人信息…</view>
  <block wx:else>
    <view class="hero">
      <text class="hero-kicker">{{roleLabel}}档案</text>
      <text class="hero-title">{{profile.real_name}}</text>
      <text class="hero-copy">{{profile.student_no || profile.employee_no || profile.login_account}} · {{profile.class_name || roleLabel}}</text>
    </view>

    <view class="card">
      <view class="section-heading">
        <text class="section-inline">个人资料</text>
        <button wx:if="{{!editing}}" class="outline compact-button" bindtap="toggleEdit">编辑</button>
      </view>
      <block wx:if="{{!editing}}">
        <view wx:for="{{rows}}" wx:key="label">
          <template is="detail-field" data="{{...item}}"/>
        </view>
      </block>
      <block wx:else>
        <view class="field">
          <text class="field-label">联系电话</text>
          <input class="input" value="{{form.phone}}" data-key="phone" bindinput="input" placeholder="请输入联系电话"/>
        </view>
        <view class="field">
          <text class="field-label">性别</text>
          <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="genderChange">
            <view class="field-picker">{{genderOptions[genderIndex]}}</view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">出生日期</text>
          <picker mode="date" value="{{form.birthDate}}" bindchange="birthChange">
            <view class="field-picker">{{form.birthDate || '请选择出生日期'}}</view>
          </picker>
        </view>
        <view class="action-bar">
          <button class="secondary" bindtap="cancelEdit">取消</button>
          <button class="primary" loading="{{actionBusy}}" disabled="{{actionBusy}}" bindtap="save">保存资料</button>
        </view>
      </block>
    </view>

    <view class="form-card">
      <text class="section-inline">修改密码</text>
      <view class="field">
        <text class="field-label">原密码</text>
        <input class="input" password placeholder="请输入原密码" data-key="oldPassword" bindinput="passwordInput"/>
      </view>
      <view class="field">
        <text class="field-label">新密码</text>
        <input class="input" password placeholder="至少 6 位" data-key="newPassword" bindinput="passwordInput"/>
      </view>
      <view class="action-bar">
        <button class="primary" bindtap="changePassword">修改密码</button>
      </view>
    </view>

    <view class="form-card">
      <button class="danger logout-button" bindtap="logout">退出登录</button>
    </view>
  </block>
</view>
