.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.section-heading .section-title { margin: 28rpx 0 12rpx; }
.small-button { min-height: 58rpx; padding: 0 16rpx; font-size: 23rpx; }
.batch-card { margin-top: 10rpx; padding: 20rpx; background: #fff; border: 1rpx solid #e1e8e5; border-radius: 6rpx; }
.batch-card > .muted { display: block; margin-top: 8rpx; }
.batch-title { min-width: 0; color: #2a403d; font-size: 27rpx; line-height: 1.4; font-weight: 650; }
.batch-card .row { align-items: flex-start; }
.batch-card .row > .status { max-width: 40%; white-space: normal; text-align: center; }
.apply-button { width: 100%; min-height: 62rpx; margin: 14rpx 0 0; font-size: 24rpx; }
.material-list { display: flex; flex-direction: column; gap: 6rpx; margin-top: 10rpx; color: #52635f; font-size: 23rpx; line-height: 1.45; }
.modal-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: center; justify-content: center; padding: 24rpx; box-sizing: border-box; background: rgba(20, 38, 36, .45); }
.form-panel { width: 100%; max-height: 88vh; overflow-y: auto; padding: 24rpx; box-sizing: border-box; background: #fff; border: 1rpx solid #dce5e2; border-radius: 8rpx; }
.form-panel .section-title { margin: 0 0 14rpx; }
.form-panel .input, .form-panel .textarea { margin-top: 10rpx; }
.form-panel picker { display: block; margin-top: 10rpx; }
.form-panel .button-row { justify-content: flex-end; }
