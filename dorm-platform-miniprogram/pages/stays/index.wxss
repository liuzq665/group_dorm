.batch-card .record-meta { display: block; }
.stays-tabs { margin: 12rpx 0 14rpx; }
.picker-arrow { color: var(--text-3); font-size: 21rpx; }
.record-more { flex: none; color: var(--brand-600); font-size: 22rpx; }
.record-note { display: block; margin-top: 10rpx; padding: 8rpx 12rpx; color: var(--brand-700); background: var(--brand-50); border-radius: var(--radius-s); font-size: 21rpx; }
.batch-cta { display: flex; justify-content: flex-end; margin-top: 12rpx; }
