<view class="page"><view wx:if="{{loading}}" class="loading">正在加载留宿信息…</view><block wx:else><text class="section-title">开放批次</text><view wx:if="{{!batches.length}}" class="card muted">当前没有可申请的留宿批次</view><view wx:for="{{batches}}" wx:key="batch_id" class="batch-card"><view class="row"><text class="batch-title">{{item.batch_name}}</text><text class="status">{{item.vacation_type==='WINTER'?'寒假':'暑假'}}</text></view><text class="muted">开放：{{item.open_start_date}} 至 {{item.open_end_date}}</text><text class="muted">申请截止：{{item.student_deadline || item.application_deadline}}</text><button class="primary apply-button" data-id="{{item.batch_id}}" bindtap="apply">填写申请</button></view><text class="section-title">我的申请</text><view wx:if="{{!applications.length}}" class="card muted">暂无留宿申请</view><view wx:else wx:for="{{applications}}" wx:key="application_id" class="batch-card" data-id="{{item.application_id}}" bindtap="detail"><view class="row"><text class="batch-title">{{item.batch_name}}</text><text class="status {{item.statusStyle}}">{{item.statusLabel}}</text></view><text class="muted">{{item.dateRangeText}}</text><text class="muted">{{item.review_reason || item.reason || '等待审核结果'}}</text></view></block></view>
