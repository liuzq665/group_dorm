<import src="../../templates/ui.wxml"/>
<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载留宿业务…</view>
  <block wx:else>
    <view class="page-heading">
      <view class="grow">
        <text class="heading-title">留宿管理</text>
        <text class="heading-sub">{{role==='STUDENT' ? '开放批次、我的申请与审核结果' : role==='DORM_MANAGER' ? '负责楼栋批次、截止时间与申请审核' : '全校批次设置、申请名单与补录'}}</text>
      </view>
      <button wx:if="{{role==='ADMIN'}}" class="primary compact-button" bindtap="openBatchForm">新增批次</button>
    </view>

    <view class="section-heading"><text class="section-inline">{{role==='STUDENT' ? '开放批次' : '批次设置'}}</text><text class="muted">{{batches.length}} 个</text></view>
    <template wx:if="{{!batches.length}}" is="empty-state" data="{{...batchEmptyView}}"/>
    <view wx:for="{{batches}}" wx:key="batch_id" class="record-card batch-card">
      <view class="record-head">
        <text class="record-title">{{item.batch_name}}</text>
        <text class="tag {{item.current_status==='OPEN'?'tag-done':'tag-muted'}}">{{item.vacation_type==='WINTER'?'寒假':'暑假'}} · {{item.current_status==='OPEN'?'开放中':'草稿'}}</text>
      </view>
      <text class="record-meta">开放区间：{{item.open_start_date}} 至 {{item.open_end_date}}</text>
      <text class="record-meta">申请截止：{{item.deadlineText}}</text>
      <text wx:if="{{item.auto_lock}}" class="record-meta">截止后自动锁定进入审核</text>
      <view wx:if="{{item.materials.length}}" class="attachment-list">
        <view class="attachment-item" wx:for="{{item.materials}}" wx:for-item="material" wx:key="file_id">
          <text class="attachment-name">材料：{{material.original_name}}</text>
        </view>
      </view>
      <block wx:if="{{role==='STUDENT'}}">
        <text wx:if="{{item.applied_status}}" class="record-note">已提交申请：{{item.applied_status}}</text>
        <view wx:if="{{!item.applied}}" class="action-bar">
          <button class="primary" data-id="{{item.batch_id}}" bindtap="apply">填写申请</button>
        </view>
        <view wx:elif="{{item.applied_editable}}" class="action-bar">
          <button class="primary" data-id="{{item.batch_id}}" bindtap="apply">继续编辑申请</button>
        </view>
        <view wx:else class="batch-cta">
          <text class="record-more" data-id="{{item.applied_application_id}}" bindtap="openApplication">查看申请 ›</text>
        </view>
      </block>
      <block wx:if="{{role==='ADMIN'}}">
        <view class="action-bar">
          <button wx:if="{{item.current_status==='DRAFT'}}" class="primary" data-id="{{item.batch_id}}" bindtap="publishBatch">发布开放</button>
          <button class="outline" data-id="{{item.batch_id}}" bindtap="uploadMaterial">上传材料示例</button>
          <button wx:if="{{item.current_status==='OPEN'}}" class="secondary" data-id="{{item.batch_id}}" bindtap="openSupplement">人工补录</button>
        </view>
      </block>
    </view>

    <view class="section-heading"><text class="section-inline">{{role==='STUDENT' ? '我的申请' : '申请名单'}}</text><text class="muted">{{filtered.length}} 条</text></view>
    <view class="filter-row">
      <picker range="{{batchOptions}}" range-key="batch_name" value="{{batchIndex}}" bindchange="chooseBatch">
        <view class="filter-select">{{batchOptions[batchIndex].batch_name}}<text class="picker-arrow">⌄</text></view>
      </picker>
    </view>
    <view class="tabs stays-tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="tab {{item.selected?'active':''}}" data-tab="{{item.key}}" bindtap="chooseTab">{{item.label}}</view>
    </view>

    <template wx:if="{{!filtered.length}}" is="empty-state" data="{{...emptyView}}"/>
    <block wx:else>
      <view class="record-list">
        <view wx:for="{{pageItems}}" wx:key="application_id" class="record-card" data-id="{{item.application_id}}" bindtap="detail">
          <view class="record-head">
            <text class="record-title">{{item.student_name || '我的申请'}} · {{item.batch_name}}</text>
            <text class="tag {{item.statusTone}}">{{item.statusLabel}}</text>
          </view>
          <text class="record-meta">{{item.student_no}} · {{item.majorLabel}}</text>
          <text class="record-meta">留宿日期：{{item.dateRangeText}}</text>
          <text class="record-meta">留宿原因：{{item.reasonText}}</text>
          <text wx:if="{{item.review_reason}}" class="record-meta">审核意见：{{item.reviewText}}</text>
          <text wx:if="{{item.resubmit_deadline}}" class="record-meta">重交截止：{{item.resubmitText}}</text>
          <view class="record-foot">
            <text class="record-time">{{item.updatedLabel}}</text>
            <text class="record-more">查看详情 ›</text>
          </view>
          <view wx:if="{{item.canLock || item.canReview}}" class="action-bar">
            <button wx:if="{{item.canLock}}" class="secondary" data-id="{{item.application_id}}" catchtap="lock">进入审核</button>
            <button wx:if="{{item.canReview}}" class="primary" data-id="{{item.application_id}}" catchtap="review">审核申请</button>
          </view>
        </view>
      </view>
      <template is="pager" data="{{...pager}}"/>
    </block>
  </block>

  <!-- 批次配置 -->
  <view wx:if="{{batchForm}}" class="modal-mask">
    <view class="modal-panel">
      <view class="modal-head"><text class="section-title">配置留宿批次</text><text class="modal-close" bindtap="closeBatchForm">关闭</text></view>
      <view class="field"><text class="field-label">批次编号</text><input class="input" data-key="batchCode" value="{{batchForm.batchCode}}" bindinput="batchInput"/></view>
      <view class="field"><text class="field-label">批次名称</text><input class="input" data-key="batchName" value="{{batchForm.batchName}}" bindinput="batchInput"/></view>
      <view class="field"><text class="field-label">学年</text><input class="input" type="number" data-key="academicYear" value="{{batchForm.academicYear}}" bindinput="batchInput"/></view>
      <view class="field">
        <text class="field-label">假期类型</text>
        <view class="tabs">
          <view class="tab {{batchForm.vacationType==='SUMMER'?'active':''}}" data-value="SUMMER" bindtap="vacation">暑假</view>
          <view class="tab {{batchForm.vacationType==='WINTER'?'active':''}}" data-value="WINTER" bindtap="vacation">寒假</view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">开放开始</text>
        <picker mode="date" data-key="openStartDate" value="{{batchForm.openStartDate}}" bindchange="batchDate">
          <view class="field-picker">{{batchForm.openStartDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">开放结束</text>
        <picker mode="date" data-key="openEndDate" value="{{batchForm.openEndDate}}" bindchange="batchDate">
          <view class="field-picker">{{batchForm.openEndDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">申请截止</text>
        <picker mode="date" data-key="applicationDeadline" value="{{batchForm.applicationDeadline}}" bindchange="batchDate">
          <view class="field-picker">{{batchForm.applicationDeadline || '选择日期'}}</view>
        </picker>
      </view>
      <view class="field"><text class="field-label">留宿注意事项</text><textarea class="textarea" data-key="instructions" value="{{batchForm.instructions}}" bindinput="batchInput"/></view>
      <view class="action-bar">
        <button class="outline" bindtap="closeBatchForm">取消</button>
        <button class="primary" bindtap="saveBatch">保存批次</button>
      </view>
    </view>
  </view>

  <!-- 人工补录 -->
  <view wx:if="{{supplementForm}}" class="modal-mask">
    <view class="modal-panel">
      <view class="modal-head"><text class="section-title">人工补录留宿人员</text><text class="modal-close" bindtap="closeSupplement">关闭</text></view>
      <view class="field">
        <text class="field-label">选择在住宿学生</text>
        <picker range="{{students}}" range-key="real_name" value="{{supplementForm.studentIndex}}" bindchange="chooseSupplementStudent">
          <view class="field-picker">{{students[supplementForm.studentIndex].real_name || '选择学生'}} · {{students[supplementForm.studentIndex].student_no || ''}}</view>
        </picker>
      </view>
      <view class="field"><text class="field-label">补录原因</text><input class="input" data-key="reason" value="{{supplementForm.reason}}" bindinput="supplementInput"/></view>
      <view class="field">
        <text class="field-label">留宿开始</text>
        <picker mode="date" data-key="startDate" value="{{supplementForm.startDate}}" bindchange="supplementDate">
          <view class="field-picker">{{supplementForm.startDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">留宿结束</text>
        <picker mode="date" data-key="endDate" value="{{supplementForm.endDate}}" bindchange="supplementDate">
          <view class="field-picker">{{supplementForm.endDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="action-bar">
        <button class="outline" bindtap="closeSupplement">取消</button>
        <button class="primary" bindtap="saveSupplement">直接通过并补录</button>
      </view>
    </view>
  </view>
</view>
