<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载工作台…</view>
  <block wx:else>
    <view class="hero role-hero role-{{role}}">
      <text class="hero-kicker">{{roleLabel}}端</text>
      <text class="hero-title">{{profile.real_name || user.name}}</text>
      <text class="hero-copy">{{headline}}</text>
      <text wx:if="{{unread}}" class="hero-unread" bindtap="goMessages">{{unread}} 条未读消息</text>
    </view>

    <view wx:if="{{role==='STUDENT'}}" class="card home-card">
      <view class="row"><text class="section-inline">当前住宿</text><text class="tag {{home ? 'tag-done' : 'tag-warning'}}">{{home ? '已分配' : '待分配'}}</text></view>
      <text wx:if="{{home}}" class="home-address">{{homeAddress}}</text>
      <text wx:else class="muted home-empty">暂未分配床位，请联系系统管理员</text>
      <view class="action-bar">
        <button class="outline" data-url="/pages/accommodation/index" bindtap="go">查看住宿与历史</button>
        <button class="secondary" data-url="/pages/repairs/index" bindtap="go">查看报修进度</button>
      </view>
    </view>

    <view wx:if="{{role!=='STUDENT' && metrics.length}}" class="metric-grid">
      <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
        <text class="metric-value">{{item.value}}</text>
        <text class="metric-label">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{showWorkload && (repairStatusRows.length || stayStatusRows.length)}}" class="card">
      <view class="section-heading"><text class="section-inline">业务状态</text><text class="muted">当前可见工单与申请</text></view>
      <view wx:if="{{repairStatusRows.length}}" class="status-group">
        <text class="status-group-title">报修工单</text>
        <view class="status-chip-list">
          <view wx:for="{{repairStatusRows}}" wx:key="label" class="status-chip"><text>{{item.label}}</text><text class="status-chip-count">{{item.count}}</text></view>
        </view>
      </view>
      <view wx:if="{{stayStatusRows.length}}" class="status-group">
        <text class="status-group-title">留宿申请</text>
        <view class="status-chip-list">
          <view wx:for="{{stayStatusRows}}" wx:key="label" class="status-chip"><text>{{item.label}}</text><text class="status-chip-count">{{item.count}}</text></view>
        </view>
      </view>
    </view>

    <text class="section-title">{{role==='STUDENT' ? '校园服务' : role==='REPAIRER' ? '维修工作' : role==='DORM_MANAGER' ? '楼栋事务' : '系统管理'}}</text>
    <view class="service-list">
      <view class="service-card {{item.wide ? 'wide' : ''}}" wx:for="{{links}}" wx:key="url" data-url="{{item.url}}" bindtap="go">
        <text class="service-mark">{{item.mark}}</text>
        <view class="service-copy">
          <text class="service-title">{{item.title}}</text>
          <text class="muted">{{item.detail}}</text>
        </view>
        <text class="service-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{role==='REPAIRER'}}" class="tip-bar">工作台数字与“维修任务”“维修记录”使用同一统计口径，如与实际工单不符请刷新页面。</view>
  </block>
</view>
