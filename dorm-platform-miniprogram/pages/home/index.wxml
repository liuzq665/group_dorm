<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载工作台…</view>
  <block wx:else>
    <view class="hero"><text class="hero-kicker">学生服务</text><text class="hero-title">你好，{{profile.real_name || user.name}}</text><text class="hero-copy">把宿舍里的事情一次办清楚</text></view>
    <view class="quick-grid">
      <view class="quick-card" bindtap="go" data-url="/pages/accommodation/index"><text class="quick-icon">⌂</text><text>我的住宿</text></view>
      <view class="quick-card" bindtap="go" data-url="/pages/messages/index"><text class="quick-icon">✦</text><text>消息中心</text><text wx:if="{{unread}}" class="badge">{{unread}}</text></view>
    </view>
    <view class="card" bindtap="go" data-url="/pages/accommodation/index"><view class="row"><text class="section-inline">当前住宿</text><text class="muted">查看详情 ›</text></view><view wx:if="{{home}}" class="home-address">{{home.building_name}} · {{home.room_no}} · {{home.bed_no}} 床</view><view wx:else class="muted">暂未分配床位，请联系管理员</view></view>
    <text class="section-title">常用服务</text>
    <view class="service-card" bindtap="go" data-url="/pages/repairs/index"><view><text class="service-title">报修进度</text><text class="muted">提交问题、跟进维修、确认评价</text></view><text class="service-arrow">›</text></view>
    <view class="service-card" bindtap="go" data-url="/pages/stays/index"><view><text class="service-title">假期留宿</text><text class="muted">填写日期段，随时查看审核结果</text></view><text class="service-arrow">›</text></view>
  </block>
</view>
