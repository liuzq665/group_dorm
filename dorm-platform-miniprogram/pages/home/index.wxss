/* 首页：低饱和角色头部 + 统一服务入口卡片 */
.role-hero {
  position: relative;
  min-height: 196rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-left: 6rpx solid rgba(255, 255, 255, .28);
}
.role-hero .hero-title, .role-hero .hero-copy, .role-hero .hero-kicker, .hero-unread { position: relative; z-index: 1; }
/* 低饱和角色基调：石墨青 / 灰松绿 / 雾蓝 / 石板灰 */
.role-hero.role-STUDENT { background: #3d5a68; border-left-color: #7fa6b5; }
.role-hero.role-DORM_MANAGER { background: #465c53; border-left-color: #a9b79a; }
.role-hero.role-REPAIRER { background: #42596b; border-left-color: #8aa8b8; }
.role-hero.role-ADMIN { background: #4b5a5e; border-left-color: #b8a68c; }
.hero-unread { align-self: flex-start; margin-top: 16rpx; padding: 6rpx 14rpx; color: #fff; background: rgba(255, 255, 255, .14); border-radius: var(--radius-s); font-size: 22rpx; }

.home-card { margin-top: 20rpx; }
.home-address { display: block; margin-top: 14rpx; color: var(--text-1); font-size: 30rpx; line-height: 1.45; font-weight: 650; word-break: break-word; }
.home-empty { display: block; margin-top: 14rpx; }

.section-title { margin-top: 32rpx; margin-bottom: 14rpx; }
.service-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.service-card {
  position: relative;
  min-width: 0;
  min-height: 148rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  background: #fff;
  border: 0;
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
}
.service-card.wide { grid-column: 1 / -1; min-height: 120rpx; }
.service-mark {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-600);
  background: var(--brand-50);
  border-radius: var(--radius-s);
  font-size: 22rpx;
  font-weight: 650;
}
.service-copy { width: 100%; min-width: 0; padding-right: 18rpx; }
.service-title { display: block; color: var(--text-1); font-size: 26rpx; line-height: 1.4; font-weight: 600; word-break: break-word; }
.service-copy .muted { display: block; margin-top: 4rpx; font-size: 21rpx; line-height: 1.45; overflow-wrap: anywhere; }
.service-arrow { position: absolute; top: 22rpx; right: 16rpx; color: var(--text-3); font-size: 28rpx; }

.status-group + .status-group { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid var(--divider); }
.status-group-title { display: block; margin-bottom: 8rpx; color: var(--text-2); font-size: 22rpx; font-weight: 600; }
.status-chip-list { display: flex; flex-wrap: wrap; gap: 8rpx; }
.status-chip { display: inline-flex; align-items: center; gap: 8rpx; max-width: 100%; padding: 7rpx 12rpx; color: var(--text-2); background: #f1f4f3; border-radius: var(--radius-s); font-size: 21rpx; }
.status-chip-count { color: var(--brand-600); font-weight: 700; }
