.tabbar {
  position: fixed;
  z-index: 10;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(106rpx + env(safe-area-inset-bottom));
  padding: 6rpx 8rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #fffef0;
  border-top: 1rpx solid #eee5bd;
  box-shadow: 0 -2rpx 10rpx rgba(40, 32, 12, .08);
}
.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  color: #6b6656;
}
/* 当前页高亮：顶部短指示条 + 图标浅色底 + 文字加粗变色 */
.tab-item.selected { color: #ffcb18; font-weight: 650; }
.tab-item.selected::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 5rpx;
  background: #ffcb18;
  border-radius: 3rpx;
}
.tab-icon {
  min-width: 40rpx;
  text-align: center;
  font-size: 29rpx;
  line-height: 1.1;
  border-radius: 50%;
  padding: 3rpx 8rpx;
  box-sizing: content-box;
}
.tab-item.selected .tab-icon { color: #ffcb18; background: #fff4a8; }
.tab-label { font-size: 20rpx; }
.tab-item.selected .tab-label { color: #ffcb18; }
.tab-badge {
  position: absolute;
  top: 2rpx;
  left: calc(50% + 14rpx);
  min-width: 26rpx;
  padding: 0 5rpx;
  height: 26rpx;
  line-height: 26rpx;
  text-align: center;
  color: #fff;
  background: #e87939;
  border-radius: 14rpx;
  font-size: 17rpx;
}
/* Shared editorial coral palette */
.tabbar { background: #fffdfb; border-top-color: #eaded8; box-shadow: 0 -8rpx 24rpx rgba(77,35,20,.07); }
.tab-item.selected { color: #ffcb18; }
.tab-item.selected::before { background: #ffcb18; }
.tab-item.selected .tab-icon { color: #ffcb18; background: #fff4a8; }
.tab-item.selected .tab-label { color: #ffcb18; }
.tab-badge { background: #e87939; }
